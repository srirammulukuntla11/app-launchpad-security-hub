# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/alsh_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/alsh_dev?retryWrites=true&w=majority

# JWT Secrets (Stage 2+ placeholders)
JWT_ACCESS_SECRET=placeholder_access_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Cookie Settings
COOKIE_SECRET=placeholder_cookie_secret_at_least_32_characters_long
